# Local development: Vite forwards /api requests to the PHP server.
VITE_API_URL=/api
BACKEND_URL=http://127.0.0.1:3000
# Never put Aiven credentials, JWT secrets or the Google client SECRET in this frontend.

# Google login: the OAuth Client ID (public, same value as GOOGLE_CLIENT_ID in the backend .env)
VITE_GOOGLE_CLIENT_ID=

# Google Maps Embed API key (optional; without it a plain Google map embed is used)
VITE_GOOGLE_MAPS_API_KEY=

# Optional: the shared "Calapan Clinic" calendar id, shows a Calendar tab for staff/doctors
VITE_GOOGLE_CALENDAR_ID=

# Optional: change what the map shows
# VITE_CLINIC_MAP_QUERY=City Health and Sanitation Department, Calapan City, Oriental Mindoro
